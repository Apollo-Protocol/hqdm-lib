{
  "name": "@apollo-protocol/hqdm-lib",
  "version": "0.1.0",
  "description": "An implementation of the HQDM ontology in TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/apollo-protocol/hqdm-lib.git"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": "./dist/*"
  },
  "scripts": {
    "prebuild": "node -p \"'export const HQDM_LIB_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "build": "tsc -p .",
    "prelint": "npm run prebuild",
    "lint": "eslint . --ext .ts",
    "pretest": "npm run lint && npm run build",
    "test": "c8 mocha \"dist/test/**/*.js\" --timeout 5000",
    "doc": "typedoc src/*.ts",
    "preversion": "npm run lint && npm run doc && npm run build",
    "version": "git add -A .",
    "prepare": "npm test"
  },
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "dependencies": {
    "@rdfjs/serializer-jsonld": "^2.0.1",
    "n3": "^1.16.3",
    "readable-stream": "^4.7.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tsconfig/node18-strictest": "^1.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/n3": "^1.26.1",
    "@types/node": "^25.5.0",
    "@types/rdfjs__serializer-jsonld": "^2.0.5",
    "@types/readable-stream": "^4.0.23",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "typescript": ">=5 <6",
    "c8": "^7.13.0",
    "typedoc": "^0.23.26",
    "eslint": "^8.34.0",
    "@typescript-eslint/parser": "^5.52.0",
    "@typescript-eslint/eslint-plugin": "^5.52.0"
  }
}
