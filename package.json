{
  "name": "@apollo-protocol/hqdm-lib",
  "version": "0.0.2",
  "description": "An implementation of the HQDM ontology in TypeScript",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./": "./dist/"
  },
  "devDependencies": {
    "@tsconfig/node18-strictest": "^1.0.0",
    "@types/chai": "^5.2.3",
    "@types/deep-eql": "^4.0.2",
    "@types/mocha": "^10.0.10",
    "@types/n3": "^1.26.1",
    "@types/node": "^25.5.0",
    "@types/rdfjs__serializer-jsonld": "^2.0.5",
    "@types/readable-stream": "^4.0.23",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/eslint-plugin-tslint": "^7.0.2",
    "@typescript-eslint/parser": "^8.57.2",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "deep-eql": "^5.0.2",
    "eslint": "^10.1.0",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unicorn": "^63.0.0",
    "mocha": "^11.7.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "ts-register": "^0.1.0",
    "tslint": "^6.1.3",
    "typedoc": "^0.28.18",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "test": "c8 mocha --require ts-node/register 'test/**/*.ts'",
    "version": "git add -A .",
    "pretest": "npm run lint && npm run build",
    "preversion": "npm run lint && npm run doc && npm run build",
    "prebuild":  "node -p \"'export const HQDM_LIB_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "build": "tsc",
    "doc": "typedoc src/*.ts",
    "prelint": "npm run prebuild",
    "lint": "eslint . --ext .ts",
    "prepare": "npm test"
  },
  "author": {
    "name": "Apollo Protocol",
    "url": "https://github.com/Apollo-Protocol"
  },
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Apollo-Protocol/hqdm-lib.git"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "dependencies": {
    "@rdfjs/serializer-jsonld": "^2.0.1",
    "n3": "^2.0.3",
    "string_decoder": "^1.3.0",
    "uuid": "^13.0.0"
  }
}
